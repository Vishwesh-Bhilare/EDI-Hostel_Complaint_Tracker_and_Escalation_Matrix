+  --ui-brand-600: #2f8f63;
+  --ui-shadow-xs: 0 1px 2px rgba(16,50,36,.04);
+  --ui-shadow-sm: 0 9px 28px rgba(16,50,36,.08);
+  --ui-shadow-md: 0 18px 44px rgba(16,50,36,.12);
+}
+
+html {
+  color-scheme: light;
+  scroll-behavior: smooth;
+}
+
+html[data-theme="dark"] {
+  color-scheme: dark;
+
+  --bg: #0b1310;
+  --card: #15211c;
+  --ink: #edf5f0;
+  --ink-soft: #a8b8b0;
+  --line: #293932;
+  --mint: #18372a;
+  --mint-deep: #285740;
+
+  --ui-bg: #0b1310;
+  --ui-surface: #15211c;
+  --ui-soft: #1a2822;
+  --ui-text: #edf5f0;
+  --ui-muted: #a8b8b0;
+  --ui-faint: #7f9087;
+  --ui-border: #293932;
+  --ui-border-strong: #395046;
+
+  --severity-critical-bg: #401e1b;
+  --severity-high-bg: #40221f;
+  --severity-medium-bg: #40331e;
+  --severity-low-bg: #193728;
+  --esc-1-bg: #40331e;
+  --esc-2-bg: #40221f;
+  --esc-3-bg: #421d1a;
