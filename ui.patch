+  transition: border-color .18s ease, box-shadow .18s ease, background-color .18s ease;
+}
+
+.form-control:focus,
+.form-select:focus {
+  background: var(--ui-surface);
+  color: var(--ui-text);
+  border-color: var(--ui-brand-600);
